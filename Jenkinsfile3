pipeline {
    agent any

    environment {
        registry = "praveendevopsk8s/my-smart-app"
        img = "${registry}:${BUILD_ID}"
        registryCredentials = 'docker-jenkins'
    }

    stages {
        stage('Checkout Code') {
            steps {
                git branch: 'main', url: 'https://github.com/praveendevopsk8s/SmartFlaskAPP.git'
                sh 'ls -l'
            }
        }

        stage('Run Unit Tests') {
            steps {
                sh 'bash ./jenkinsscript.sh'
            }
        }

        stage('Publish Junit Report') {
            steps {
                junit skipMarkingBuildUnstable: true, testResults: 'xmlReport/output.xml'
            }
        }

        stage('Publish Code Coverage') {
            steps {
                cobertura coberturaReportFile: 'coverage.xml'
            }
        }

        stage('Docker Build') {
            steps {
                script {
                    dockerImage = docker.build("${img}")
                }
            }
        }

        stage('Docker Push') {
            steps {
                script {
                    withDockerRegistry(credentialsId: registryCredentials) {
                        dockerImage.push()
                        dockerImage.push('latest')
                    }
                }
            }
        }

        stage('Run Container') {
            steps {
                script {
                    env.CONTAINER_ID = sh(
                        script: "docker run -d -p 5010:5000 ${img}",
                        returnStdout: true
                    ).trim()
                    echo "Container ID: ${env.CONTAINER_ID}"
                }
            }
        }

        stage('Stop Container') {
            steps {
                script {
                    sh "docker stop ${env.CONTAINER_ID} || true"
                }
            }
        }
    }
}
